      "description": "Créer un nouveau message",
      "url": "/chatroom",
      "icons": [
        {
          "src": "/icons/shortcut-message.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Recherche",
      "short_name": "Recherche",
      "description": "Rechercher des messages et utilisateurs",
      "url": "/chatroom?search=true",
      "icons": [
        {
          "src": "/icons/shortcut-search.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
