generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  username    String   @unique
  email       String   @unique
  password    String
  age         Int
  gender      String
  interests   String
  intentions  String
  avatar      String?
  isOnline    Boolean  @default(false)
  lastSeen    DateTime @default(now())
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sentMessages      Message[]   @relation("MessageSender")
  receivedMessages  Message[]   @relation("MessageReceiver")
  rooms             RoomUser[]
  createdRooms      Room[]      @relation("RoomCreator")
  sharedFiles       SharedFile[]
  receivedFiles     SharedFile[] @relation("SharedFileReceiver")
  blockedUsers      BlockedUser[] @relation("BlockerUser")
  blockedByUsers    BlockedUser[] @relation("BlockedUser")
  deletedMessages   DeletedMessageUser[]
  reactions         MessageReaction[]
}

model Room {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  type        String
  icon        String   @default("💬")
  isPrivate   Boolean  @default(false)
  maxMembers  Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creatorId   String
  creator     User     @relation("RoomCreator", fields: [creatorId], references: [id])
  messages    Message[]
  users       RoomUser[]
  sharedFiles SharedFile[]
}

model RoomUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  joinedAt  DateTime @default(now())
  isMuted   Boolean  @default(false)
  role      String   @default("member")
  userId    String
  roomId    String
  user      User     @relation(fields: [userId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
  @@unique([userId, roomId])
}

model Message {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  content     String
  isPrivate   Boolean  @default(false)
  isEdited    Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  senderId    String
  receiverId  String?
  roomId      String?
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  receiver    User?    @relation("MessageReceiver", fields: [receiverId], references: [id])
  room        Room?    @relation(fields: [roomId], references: [id])
  deletedBy   DeletedMessageUser[]
  reactions   MessageReaction[]
}

model SharedFile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  fileName    String
  originalName String
  filePath    String
  fileType    String
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())
  senderId    String
  receiverId  String?
  roomId      String?
  sender      User     @relation(fields: [senderId], references: [id])
  receiver    User?    @relation("SharedFileReceiver", fields: [receiverId], references: [id])
  room        Room?    @relation(fields: [roomId], references: [id])
}

model BlockedUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  blockerId String
  blockedId String
  blocker   User     @relation("BlockerUser", fields: [blockerId], references: [id])
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id])
  @@unique([blockerId, blockedId])
}

model DeletedMessageUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  messageId String
  deletedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  message   Message  @relation(fields: [messageId], references: [id])
  @@unique([userId, messageId])
}

model MessageReaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  emoji     String
  createdAt DateTime @default(now())
  userId    String
  messageId String
  user      User     @relation(fields: [userId], references: [id])
  message   Message  @relation(fields: [messageId], references: [id])
  @@unique([userId, messageId, emoji])
}
