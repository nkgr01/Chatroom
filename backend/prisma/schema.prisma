generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
-- Enable UUID extension if needed (for Prisma)
-- CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- Table: blocked_users
CREATE TABLE "blocked_users" (
  "id" SERIAL PRIMARY KEY,
  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
  "blockerId" INTEGER NOT NULL,
  "blockedId" INTEGER NOT NULL
);

-- Table: deleted_message_users
CREATE TABLE "deleted_message_users" (
  "id" SERIAL PRIMARY KEY,
  "userId" INTEGER NOT NULL,
  "messageId" INTEGER NOT NULL,
  "deletedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- Table: messages
CREATE TABLE "messages" (
  "id" SERIAL PRIMARY KEY,
  "content" TEXT NOT NULL,
  "isPrivate" BOOLEAN NOT NULL DEFAULT FALSE,
  "isEdited" BOOLEAN NOT NULL DEFAULT FALSE,
  "isDeleted" BOOLEAN NOT NULL DEFAULT FALSE,
  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
  "updatedAt" TIMESTAMP(3) NOT NULL,
  "senderId" INTEGER NOT NULL,
  "receiverId" INTEGER,
  "roomId" INTEGER
);

-- Table: rooms
CREATE TABLE "rooms" (
  "id" SERIAL PRIMARY KEY,
  "name" VARCHAR(191) NOT NULL,
  "description" VARCHAR(191),
  "type" VARCHAR(191) NOT NULL,
  "icon" VARCHAR(191) NOT NULL DEFAULT '?',
  "isPrivate" BOOLEAN NOT NULL DEFAULT FALSE,
  "maxMembers" INTEGER NOT NULL DEFAULT 100,
  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
  "updatedAt" TIMESTAMP(3) NOT NULL,
  "creatorId" INTEGER NOT NULL
);

-- Table: room_users
CREATE TABLE "room_users" (
  "id" SERIAL PRIMARY KEY,
  "joinedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
  "isMuted" BOOLEAN NOT NULL DEFAULT FALSE,
  "role" VARCHAR(191) NOT NULL DEFAULT 'member',
  "userId" INTEGER NOT NULL,
  "roomId" INTEGER NOT NULL
);

-- Table: shared_files
CREATE TABLE "shared_files" (
  "id" SERIAL PRIMARY KEY,
  "fileName" VARCHAR(191) NOT NULL,
  "originalName" VARCHAR(191) NOT NULL,
  "filePath" VARCHAR(191) NOT NULL,
  "fileType" VARCHAR(191) NOT NULL,
  "fileSize" INTEGER NOT NULL,
  "mimeType" VARCHAR(191) NOT NULL,
  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
  "senderId" INTEGER NOT NULL,
  "roomId" INTEGER,
  "receiverId" INTEGER
);

-- Table: users
CREATE TABLE "users" (
  "id" SERIAL PRIMARY KEY,
  "username" VARCHAR(191) NOT NULL,
  "email" VARCHAR(191) NOT NULL,
  "password" VARCHAR(191) NOT NULL,
  "age" INTEGER NOT NULL,
  "gender" VARCHAR(191) NOT NULL,
  "interests" VARCHAR(191) NOT NULL,
  "intentions" VARCHAR(191) NOT NULL,
  "avatar" VARCHAR(191),
  "isOnline" BOOLEAN NOT NULL DEFAULT FALSE,
  "lastSeen" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
  "isBlocked" BOOLEAN NOT NULL DEFAULT FALSE,
  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
  "updatedAt" TIMESTAMP(3) NOT NULL
);

-- Table: _prisma_migrations (Prisma gère ça, mais on la crée si besoin)
CREATE TABLE "_prisma_migrations" (
  "id" VARCHAR(36) PRIMARY KEY,
  "checksum" VARCHAR(64) NOT NULL,
  "finished_at" TIMESTAMP(3),
  "migration_name" VARCHAR(255) NOT NULL,
  "logs" TEXT,
  "rolled_back_at" TIMESTAMP(3),
  "started_at" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
  "applied_steps_count" INTEGER NOT NULL DEFAULT 0
);

-- Index uniques
CREATE UNIQUE INDEX "blocked_users_blockerId_blockedId_key" ON "blocked_users"("blockerId", "blockedId");
CREATE UNIQUE INDEX "deleted_message_users_userId_messageId_key" ON "deleted_message_users"("userId", "messageId");
CREATE UNIQUE INDEX "rooms_name_key" ON "rooms"("name");
CREATE UNIQUE INDEX "room_users_userId_roomId_key" ON "room_users"("userId", "roomId");
CREATE UNIQUE INDEX "users_username_key" ON "users"("username");
CREATE UNIQUE INDEX "users_email_key" ON "users"("email");

-- Index pour les clés étrangères
CREATE INDEX "blocked_users_blockedId_fkey" ON "blocked_users"("blockedId");
CREATE INDEX "deleted_message_users_messageId_fkey" ON "deleted_message_users"("messageId");
CREATE INDEX "messages_senderId_fkey" ON "messages"("senderId");
CREATE INDEX "messages_receiverId_fkey" ON "messages"("receiverId");
CREATE INDEX "messages_roomId_fkey" ON "messages"("roomId");
CREATE INDEX "rooms_creatorId_fkey" ON "rooms"("creatorId");
CREATE INDEX "room_users_roomId_fkey" ON "room_users"("roomId");
CREATE INDEX "shared_files_senderId_fkey" ON "shared_files"("senderId");
CREATE INDEX "shared_files_roomId_fkey" ON "shared_files"("roomId");
CREATE INDEX "shared_files_receiverId_fkey" ON "shared_files"("receiverId");

-- Contraintes (Foreign Keys)
ALTER TABLE "blocked_users" ADD CONSTRAINT "blocked_users_blockerId_fkey" 
  FOREIGN KEY ("blockerId") REFERENCES "users"("id") ON UPDATE CASCADE;

ALTER TABLE "blocked_users" ADD CONSTRAINT "blocked_users_blockedId_fkey" 
  FOREIGN KEY ("blockedId") REFERENCES "users"("id") ON UPDATE CASCADE;

ALTER TABLE "deleted_message_users" ADD CONSTRAINT "deleted_message_users_userId_fkey" 
  FOREIGN KEY ("userId") REFERENCES "users"("id") ON DELETE CASCADE ON UPDATE CASCADE;

ALTER TABLE "deleted_message_users" ADD CONSTRAINT "deleted_message_users_messageId_fkey" 
  FOREIGN KEY ("messageId") REFERENCES "messages"("id") ON DELETE CASCADE ON UPDATE CASCADE;

ALTER TABLE "messages" ADD CONSTRAINT "messages_senderId_fkey" 
  FOREIGN KEY ("senderId") REFERENCES "users"("id") ON UPDATE CASCADE;

ALTER TABLE "messages" ADD CONSTRAINT "messages_receiverId_fkey" 
  FOREIGN KEY ("receiverId") REFERENCES "users"("id") ON DELETE SET NULL ON UPDATE CASCADE;

ALTER TABLE "messages" ADD CONSTRAINT "messages_roomId_fkey" 
  FOREIGN KEY ("roomId") REFERENCES "rooms"("id") ON DELETE SET NULL ON UPDATE CASCADE;

ALTER TABLE "rooms" ADD CONSTRAINT "rooms_creatorId_fkey" 
  FOREIGN KEY ("creatorId") REFERENCES "users"("id") ON UPDATE CASCADE;

ALTER TABLE "room_users" ADD CONSTRAINT "room_users_userId_fkey" 
  FOREIGN KEY ("userId") REFERENCES "users"("id") ON DELETE CASCADE ON UPDATE CASCADE;

ALTER TABLE "room_users" ADD CONSTRAINT "room_users_roomId_fkey" 
  FOREIGN KEY ("roomId") REFERENCES "rooms"("id") ON DELETE CASCADE ON UPDATE CASCADE;

ALTER TABLE "shared_files" ADD CONSTRAINT "shared_files_senderId_fkey" 
  FOREIGN KEY ("senderId") REFERENCES "users"("id") ON UPDATE CASCADE;

ALTER TABLE "shared_files" ADD CONSTRAINT "shared_files_roomId_fkey" 
  FOREIGN KEY ("roomId") REFERENCES "rooms"("id") ON DELETE SET NULL ON UPDATE CASCADE;

ALTER TABLE "shared_files" ADD CONSTRAINT "shared_files_receiverId_fkey" 
  FOREIGN KEY ("receiverId") REFERENCES "users"("id") ON DELETE SET NULL ON UPDATE CASCADE;
