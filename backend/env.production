# Configuration de production pour ConnectChat
# ⚠️ NE PAS COMMITTER CE FICHIER - Il contient des secrets !

# Configuration de la base de données
DATABASE_URL="mysql://username:password@host:port/database"

# Clé secrète JWT (changez ceci en production !)
JWT_SECRET="votre_secret_jwt_tres_securise_et_long_au_moins_32_caracteres"

# Port du serveur
PORT=10000

# URL du frontend (pour CORS)
FRONTEND_URL="https://votre-app.vercel.app"

# Configuration de production
NODE_ENV="production"

# Configuration des uploads
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=10485760

# Configuration de sécurité
ENCRYPTION_KEY="votre_cle_de_chiffrement_32_caracteres_exactement"

# Configuration de la base de données
DB_HOST="votre-host-mysql"
DB_PORT="3306"
DB_NAME="connectchat"
DB_USER="votre-username"
DB_PASS="votre-password"

# Configuration des logs
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"

# Configuration des sessions
SESSION_SECRET="votre_secret_session_tres_securise"

# Configuration des cookies
COOKIE_SECRET="votre_secret_cookie_tres_securise"
